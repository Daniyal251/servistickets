{
  "name": "ticket-service",
  "version": "1.0.0",
  "private": true,
  "description": "Сервис продажи билетов с поддержкой 2000+ concurrent пользователей",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ticket-service/api db:migrate",
    "db:seed": "pnpm --filter @ticket-service/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
