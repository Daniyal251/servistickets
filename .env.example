# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_service?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API
PORT=4000
FRONTEND_URLS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Payment (example for Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (example for SendGrid)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@ticketservice.com"

# Environment
NODE_ENV="development"
